Package: rqrgibbs
Type: Package
Title: Mean-Tilted Interval Regression and Bayesian Shortest-Interval Inference
Version: 0.1.0.9036
Authors@R: c(
    person("Antonio", "De Leon", role = c("aut", "cre"),
           email = "jaguir26@ucsc.edu"),
