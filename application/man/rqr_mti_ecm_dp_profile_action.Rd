\title{DP-calibrated MTI-ECM profile action}
\usage{
rqr_mti_ecm_dp_profile_action(
  y,
  content,
  posterior_confidence,
  dp_concentration = 1,
  dp_base_measure = rqr_dp_base_normal(mean = 0, sd = 4),
