% Generated by Codex for report6 Bayesian UQ integration.
\name{rqr_dpm_fit}
\alias{rqr_dpm_fit}
\alias{rqr_dpm_density}
\alias{rqr_dpm_cdf}
\alias{rqr_dpm_quantile}
\alias{rqr_dpm_content_probability}
\alias{rqr_dpm_shortest_draws}
\alias{rqr_dpm_bayes_tolerance_action}
\alias{rqr_dpm_ecm_fit}
\title{Gaussian DPM shortest-interval uncertainty quantification}
\usage{
rqr_dpm_fit(
  y,
  truncation_level = 10L,
  concentration = 1,
  sample_concentration = FALSE,
  hyper = list(),
  mcmc_control = list(),
  init = list(),
  na_rm = FALSE
)

rqr_dpm_density(fit, x, draw = NULL)

rqr_dpm_cdf(fit, x, draw = NULL)

rqr_dpm_quantile(fit, p, draw = 1L, tolerance = 1e-8)

rqr_dpm_content_probability(fit, lower, upper, content)

rqr_dpm_shortest_draws(
  fit,
  target_content,
  grid_size = 101L,
  optimize = TRUE,
  tolerance = 1e-8
)

rqr_dpm_bayes_tolerance_action(
  fit,
  content,
  posterior_confidence,
  action_class = "closed_order_statistic_intervals"
)

rqr_dpm_ecm_fit(
  y,
  truncation_level = 10L,
  concentration = 1,
  optimize_concentration = FALSE,
  hyper = list(),
  ecm_control = list(),
  init = list(),
  na_rm = FALSE
)
}
\arguments{
\item{y}{Numeric univariate response sample.}
\item{truncation_level}{Number of atoms in the finite stick-breaking
approximation.}
\item{concentration}{Positive Dirichlet-process concentration parameter.}
\item{sample_concentration}{Sample the concentration conditional on the
retained sticks.}
\item{hyper}{Normal-Gamma and concentration hyperparameters.}
\item{mcmc_control}{MCMC controls including \code{n_iter}, \code{burn_in},
\code{thin}, \code{seed}, and \code{store_allocations}.}
\item{init}{Optional initial weights, means, and precisions.}
\item{na_rm}{Remove missing responses.}
\item{fit}{A fit from \code{rqr_dpm_fit()} or, for density/CDF diagnostics,
\code{rqr_dpm_ecm_fit()}.}
\item{x}{Evaluation points.}
\item{draw}{Retained posterior draw index.  If omitted in density/CDF calls,
posterior means are returned.}
\item{p}{Probabilities in \((0,1)\).}
\item{tolerance}{Numerical tolerance.}
\item{lower, upper}{Closed interval endpoints.}
\item{content}{Required population content.}
\item{target_content}{Shortest-interval content.}
\item{grid_size}{Lower-tail grid size for shortest-interval search.}
\item{optimize}{Locally refine the best grid interval.}
\item{posterior_confidence}{Required posterior probability that interval
content is at least \code{content}.}
\item{action_class}{Candidate interval class.  Currently only closed
order-statistic intervals are implemented.}
\item{optimize_concentration}{Reserved deterministic concentration update for
the ECM diagnostic.}
\item{ecm_control}{ECM controls including \code{max_iter},
\code{tol_objective}, \code{monotone_tolerance}, \code{seed}, and
\code{backtracking_max_steps}.}
}
\description{
Fits a smooth truncated Gaussian Dirichlet-process mixture response model and
computes posterior content and shortest-interval functionals from retained
mixture draws.
}
\details{
The Gibbs sampler uses a finite stick-breaking approximation with Gaussian
kernel likelihoods and Normal-Gamma component priors.  Content probabilities
are Monte Carlo posterior probabilities across retained mixture draws.  The
shortest-interval functional minimizes quantile width over the lower-tail
probability and records the numerical search method.

\code{rqr_dpm_ecm_fit()} is a deterministic MAP-style diagnostic and
initializer.  It does not return posterior draws and is not promoted as
Bayesian uncertainty quantification.

The DPM functions are response-likelihood tools for \(F\).  They are distinct
from RQR generalized-Bayes updates, whose uncertainty concerns loss-based
interval-root functionals.
}
\value{
Schema-versioned fit, action, or data-frame objects.  DPM MCMC fits set
\code{response_likelihood = TRUE} and \code{generalized_bayes = FALSE}.
}
\seealso{\code{\link{rqr_dp_fit}},
\code{\link{rqr_tcsp_hybrid_bayes_fit}}}
