rqr_tcsp_tilt_from_window(window)

rqr_tcsp_fit_univariate(
  y,
  guaranteed_content,
  tolerance_confidence,
  scan_method = c("monte_carlo_conservative", "dkw_conservative"),
  n_sim = 20000L,
  numerical_confidence = 0.999,
  seed = NULL,
  fit_mcmc = FALSE,
  learning_rate = 1,
  mcmc_args = list(),
  na_rm = FALSE
)

rqr_tcsp_path(
  y,
  guaranteed_contents,
  tolerance_confidence,
  scan_method = c("monte_carlo_conservative", "dkw_conservative"),
  n_sim = 20000L,
  numerical_confidence = 0.999,
  seed = NULL,
  na_rm = FALSE
)

rqr_tcsp_predict_next_start(previous_window, next_retained_count, n = previous_window$sample_size)

rqr_tcsp_local_correct(y, retained_count, predicted_start, trust_radius = 2L, global_window = NULL)

rqr_tcsp_validate_action(fit)
}
\arguments{
\item{n}{Sample size.}
\item{guaranteed_content}{Minimum population content \(c\).}
\item{retained_count}{Candidate retained count \(k\).}
\item{method, scan_method}{Critical-value method. Exact scan recursion is not implemented.}
\item{n_sim}{Number of Monte Carlo replicates for the conservative scan method.}
\item{numerical_confidence}{Confidence level for numerical calibration error control.}
\item{seed}{Optional simulation seed.}
\item{distribution}{A simulated Uniform scan-statistic distribution from
\code{rqr_tcsp_scan_distribution()}.}
\item{tolerance_confidence}{Repeated-sample tolerance confidence \eqn{1-\alpha}.}
\item{y}{Numeric response sample.}
\item{na_rm}{Remove nonfinite observations before scanning.}
\item{window}{A TCSP shortest-window object.}
\item{fit_mcmc}{Fit the intercept-only fixed-target generalized posterior.}
\item{learning_rate}{Fixed generalized-Bayes learning rate \eqn{\omega}.}
\item{mcmc_args}{Optional arguments passed to \code{rqr_mcmc_fit()}.}
\item{guaranteed_contents}{Ordered or unordered vector of target contents.}
\item{previous_window}{Previous TCSP window object.}
\item{next_retained_count}{Next retained count for path prediction.}
\item{trust_radius}{Local start-index trust-region radius.}
\item{predicted_start}{Predicted local start index.}
\item{global_window}{Optional globally verified shortest-window object.}
\item{fit}{A TCSP fit or action contract.}
}
\description{
Utilities for the scan-calibrated tolerance-calibrated shortest-path
mean-tilted RQR branch layer. The formal action is the first minimum-width
closed order-statistic window \eqn{[Y_{(j)},Y_{(j+k-1)}]} after calibrating
\eqn{k}. The generalized posterior is fitted only after \eqn{q=k/n} and the
retained-mean tilt are frozen.
}
\details{
The tolerance certificate comes from scan calibration, not from posterior
credibility, the learning rate, or a response likelihood. The current
implementation provides conservative Monte Carlo and DKW calibration paths.
Monte Carlo calibration simulates the Uniform scan-statistic distribution once
per \code{n}/content cell and applies a simultaneous Massart-DKW empirical-CDF
lower band over all retained-count candidates. It is numerical calibration,
not an exact scan recursion and not a pointwise post-selection
Clopper-Pearson certificate.
The DKW path uses the strict retained-count rule
\eqn{k/n > c + 2\epsilon_n} implied by the uniform band. Unsupported or
infeasible requests fail closed.
}
\value{
Lists with schema-versioned calibration, action, path, or validation metadata.
When \code{rqr_tcsp_fit_univariate(fit_mcmc = TRUE)} is used, the returned
object also contains an \code{rqr_mcmc} fit for the fixed calibrated target.
}
\seealso{\code{\link{rqr_mt_tilt_empirical_shortest}}, \code{\link{rqr_mcmc_fit}}}
