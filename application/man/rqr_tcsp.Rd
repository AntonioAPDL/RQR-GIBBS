\title{Scan-calibrated TCSP-MT-RQR tolerance actions}
\usage{
rqr_tcsp_scan_probability(
  n,
  guaranteed_content,
  retained_count,
  method = c("monte_carlo_conservative", "dkw_conservative"),
  n_sim = 20000L,
  numerical_confidence = 0.999,
  seed = NULL
)

rqr_tcsp_scan_distribution(
  n,
  guaranteed_content,
  n_sim = 20000L,
  seed = NULL
)

rqr_tcsp_scan_cdf_band(distribution, numerical_confidence = 0.999)

rqr_tcsp_calibrate_count(
  n,
  guaranteed_content,
  tolerance_confidence,
  method = c("monte_carlo_conservative", "dkw_conservative"),
  n_sim = 20000L,
  numerical_confidence = 0.999,
  seed = NULL
)

rqr_tcsp_scan_count(
  n,
  guaranteed_content,
  tolerance_confidence,
  method = c("monte_carlo_conservative", "dkw_conservative"),
  n_sim = 20000L,
  numerical_confidence = 0.999,
