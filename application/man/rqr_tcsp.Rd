\name{rqr_tcsp_scan_probability}
\alias{rqr_tcsp_scan_probability}
\alias{rqr_tcsp_scan_distribution}
\alias{rqr_tcsp_scan_cdf_band}
\alias{rqr_tcsp_calibrate_count}
\alias{rqr_tcsp_scan_count}
