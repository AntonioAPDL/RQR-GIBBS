% Generated by Codex for report6 Bayesian UQ integration.
\name{rqr_tcsp_hybrid_bayes_fit}
\alias{rqr_tcsp_hybrid_bayes_fit}
\title{Hybrid Bayesian-scan shortest tolerance action}
\usage{
rqr_tcsp_hybrid_bayes_fit(
  y,
  guaranteed_content,
  tolerance_confidence,
  posterior_confidence,
  distribution_engine = c("direct_dp", "gaussian_dpm"),
  scan_method = c("monte_carlo_conservative", "monte_carlo_cp_adaptive", "dkw_conservative"),
  action_class = "closed_order_statistic_intervals",
  distribution_args = list(),
  scan_args = list(),
  action_control = list(),
  na_rm = FALSE
)
}
\arguments{
\item{y}{Numeric univariate response sample.}
\item{guaranteed_content}{Minimum population content \(c\).}
\item{tolerance_confidence}{Repeated-sample scan tolerance confidence.}
\item{posterior_confidence}{Posterior probability threshold for the Bayesian
content constraint.}
\item{distribution_engine}{Full-distribution Bayesian engine:
\code{"direct_dp"} or \code{"gaussian_dpm"}.}
\item{scan_method}{TCSP scan calibration method.}
\item{action_class}{Candidate interval class.  Currently only closed
order-statistic intervals are implemented.}
\item{distribution_args}{Arguments passed to the selected distribution engine.
The direct-DP engine requires \code{concentration} and \code{base_measure}.}
\item{scan_args}{Arguments passed to \code{rqr_tcsp_calibrate_count()} other
than sample size, content, confidence, and method.  Long validation runs may
also pass a compatible precomputed \code{calibration} object to avoid repeated
scan-critical recalibration.}
\item{action_control}{Action controls.  \code{n_shortest_draws} requests
posterior shortest-functional draws; \code{dp_draw_args} are passed to
\code{rqr_dp_draws()} for the direct-DP engine.}
\item{na_rm}{Remove missing responses.}
}
\description{
Constructs the hybrid Bayesian-scan tolerance action.  The action is the first
minimum-width closed order-statistic interval satisfying both a fixed scan
count and a posterior content-probability threshold under a full-distribution
Bayesian model for \eqn{F}.
}
\details{
The scan layer controls repeated-sampling tolerance calibration through the
fixed retained-count constraint \eqn{N_n(I) >= k_{n,c,alpha_s}}.  The Bayesian
layer evaluates \eqn{Pr(F(I) >= c | y)} under a response-distribution
posterior.  The direct-DP engine evaluates this probability exactly for each
fixed candidate interval using the Beta law; the Gaussian DPM engine estimates
it across retained posterior mixture draws.

The scan count is fixed and is not resampled inside the Bayesian posterior.
The posterior credibility level is distinct from tolerance confidence.  The
returned object marks \code{response_likelihood = TRUE},
\code{generalized_bayes = FALSE}, and
\code{posterior_endpoint_coverage_claim_available = FALSE}.
}
\value{
An \code{rqr_hybrid_bayes_tcsp} object with the formal action, scan contract,
posterior distribution fit, Bayesian-only action, hybrid action, optional
posterior shortest-target draws, and provenance metadata.
}
\seealso{\code{\link{rqr_dp_fit}}, \code{\link{rqr_dpm_fit}},
\code{\link{rqr_tcsp_fit_univariate}}}
